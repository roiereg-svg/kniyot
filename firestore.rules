rules_version = '2';

// Kniyot: shared shopping lists.
// A group is readable and writable only by its members. Only the owner manages members and invites.
// An invite link alone gives no access: joining needs a signed-in account and an unused, unexpired,
// unrevoked invite, and the join is written in one batch with the invite marked as used.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function isMember(gid) { return signedIn() && me() in get(groupPath(gid)).data.memberIds; }
    function isMemberAfter(gid) { return signedIn() && me() in getAfter(groupPath(gid)).data.memberIds; }
    function isOwner(gid) { return signedIn() && get(groupPath(gid)).data.ownerId == me(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, max) { return v is string && v.size() >= 1 && v.size() <= max; }

    // ---------- private profile and the list of my groups ----------
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // ---------- groups ----------
    match /groups/{gid} {
      allow read: if isMember(gid);

      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && str(request.resource.data.name, 40)
        && request.resource.data.keys().hasOnly(['name', 'color', 'icon', 'ownerId', 'memberIds', 'createdAt']);

      // The owner may rename and recolour the group.
      allow update: if isOwner(gid)
        && changed().hasOnly(['name', 'color', 'icon'])
        && str(request.resource.data.name, 40);

      // The owner may remove members (never add them, never remove himself).
      allow update: if isOwner(gid)
        && changed().hasOnly(['memberIds'])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && me() in request.resource.data.memberIds;

      // A member who is not the owner may leave: only his own id disappears.
      allow update: if isMember(gid)
        && resource.data.ownerId != me()
        && changed().hasOnly(['memberIds'])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && !(me() in request.resource.data.memberIds);

      // Joining: add only yourself, with a valid invite of this group that this same batch marks as used by you.
      allow update: if signedIn()
        && !(me() in resource.data.memberIds)
        && changed().hasOnly(['memberIds', 'joinInvite'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && me() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.joinInvite is string
        && get(invitePath(request.resource.data.joinInvite)).data.groupId == gid
        && get(invitePath(request.resource.data.joinInvite)).data.usedBy == null
        && get(invitePath(request.resource.data.joinInvite)).data.revoked == false
        && get(invitePath(request.resource.data.joinInvite)).data.expiresAt > request.time
        && getAfter(invitePath(request.resource.data.joinInvite)).data.usedBy == me();

      allow delete: if isOwner(gid);

      // Public face of each member inside the group: name and photo.
      match /members/{uid} {
        allow read: if isMember(gid);
        allow create, update: if signedIn() && me() == uid && isMemberAfter(gid)
          && request.resource.data.keys().hasOnly(['name', 'photo', 'joinedAt'])
          && str(request.resource.data.name, 40)
          && (!('photo' in request.resource.data) || request.resource.data.photo is string && request.resource.data.photo.size() <= 150000);
        allow delete: if signedIn() && (me() == uid || isOwner(gid));
      }

      match /items/{itemId} {
        allow read, delete: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.addedBy == me()
          && str(request.resource.data.name, 100);
        allow update: if isMember(gid)
          && str(request.resource.data.name, 100)
          && request.resource.data.addedBy == resource.data.addedBy;
      }

      // Category corrections learned by the group.
      match /meta/{docId} {
        allow read, write: if isMember(gid);
      }
    }

    // ---------- invites ----------
    // The code is long and random. Anyone holding it may read who invited him and to which group,
    // so the join screen can show it before sign-in. Nothing else of the group is visible.
    match /invites/{code} {
      allow get: if true;
      allow list: if signedIn() && resource.data.createdBy == me();

      allow create: if signedIn()
        && isOwner(request.resource.data.groupId)
        && request.resource.data.createdBy == me()
        && request.resource.data.usedBy == null
        && request.resource.data.revoked == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && str(request.resource.data.groupName, 40)
        && str(request.resource.data.inviterName, 40)
        && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'inviterName', 'createdBy', 'createdAt', 'expiresAt', 'usedBy', 'revoked']);

      // The owner cancels a link.
      allow update: if signedIn()
        && resource.data.createdBy == me()
        && changed().hasOnly(['revoked'])
        && request.resource.data.revoked == true;

      // Using a link: once, before it expires, only for yourself, together with joining the group.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.revoked == false
        && resource.data.expiresAt > request.time
        && changed().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == me()
        && me() in getAfter(groupPath(resource.data.groupId)).data.memberIds;

      allow delete: if signedIn() && resource.data.createdBy == me();
    }
  }
}
